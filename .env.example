# ============================================
# Goose Egress Sandbox - 環境変数設定
# ============================================
# 使用するLLMプロバイダーのAPIキーのみ設定してください。
# 不要なプロバイダーはコメントアウトまたは空欄のままで構いません。
# このファイルをコピーして .env を作成: cp .env.example .env

# --- OpenAI ---
OPENAI_API_KEY=

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=

# --- Google (Gemini) ---
GOOGLE_API_KEY=

# --- Azure OpenAI ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-02-01

# --- AWS Bedrock ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# --- Mistral AI ---
MISTRAL_API_KEY=

# --- Groq ---
GROQ_API_KEY=

# --- OpenRouter ---
OPENROUTER_API_KEY=

# --- Together AI ---
TOGETHER_API_KEY=

# --- Cohere ---
COHERE_API_KEY=

# --- Ollama（ローカル実行時） ---
# OLLAMA_HOST=http://host.docker.internal:11434

# --- Goose設定 ---
# GOOSE_PROVIDER=openai
# GOOSE_MODEL=gpt-4o

# --- プライバシー / テレメトリ設定 ---
# 匿名の利用実績データ送信を無効化（デフォルト: false）
GOOSE_TELEMETRY_ENABLED=false

# --- タイムゾーン設定 ---
# デスクトップ時計およびログのタイムゾーン (例: Asia/Tokyo, UTC, America/New_York)
TZ=Asia/Tokyo
