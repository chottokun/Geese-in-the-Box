# ============================================
# Goose Egress Sandbox - 環境変数設定
# ============================================
# このファイルをコピーして .env を作成: cp .env.example .env

# ============================================
# 1. LLM プロバイダー設定 & API キー
# ============================================
# 使用するプロバイダーのAPIキーを設定してください（不要なものは空欄で可）。

# --- OpenAI & OpenAI互換エンドポイント (vLLM, LocalAI, OpenRouter, 自前API等) ---
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_HOST=https://api.openai.com
# OPENAI_MODEL=gpt-4o
# (ローカル/ホスト上のOpenAI互換サーバー例: OPENAI_BASE_URL=http://host.docker.internal:8000/v1)


# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=

# --- Google (Gemini) ---
GOOGLE_API_KEY=

# --- Azure OpenAI ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-02-01

# --- AWS Bedrock ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# --- Mistral AI ---
MISTRAL_API_KEY=

# --- Groq ---
GROQ_API_KEY=

# --- OpenRouter ---
OPENROUTER_API_KEY=

# --- Together AI ---
TOGETHER_API_KEY=

# --- Cohere ---
COHERE_API_KEY=

# --- Ollama（ホスト側のローカルLLM利用時） ---
# OLLAMA_HOST=http://host.docker.internal:11434

# --- Goose デフォルトモデル設定 ---
# GOOSE_PROVIDER=openai
# GOOSE_MODEL=gpt-4o

# ============================================
# 2. ポート設定（ホスト公開ポート）
# ============================================
# バインド先ホストIP (ローカル限定推奨: 127.0.0.1, LAN開放: 0.0.0.0, 特定NIC IP指定可能)
HOST_BIND=127.0.0.1

# noVNC Webデスクトップ接続ポート (ブラウザで開くポート)
NOVNC_PORT=6080

# Goose ACP サーバーポート (公式Goose Desktopからの接続用)
GOOSE_SERVE_PORT=3284

# Squid プロキシポート (外部通信の監査・中継用)
SQUID_PORT=3128

# Dozzle Web ログ監視ポート
DOZZLE_PORT=8080

# 可観測性ダッシュボード自動集計インターバル（秒、デフォルト: 30）
REPORT_INTERVAL=30

# ============================================
# 3. 画面 & ロケール設定
# ============================================
# 仮想デスクトップ解像度 (幅x高さx色深度)
RESOLUTION=1280x800x24

# タイムゾーン (デスクトップ時計・監査ログ時刻)
TZ=Asia/Tokyo

# ============================================
# 4. セキュリティ & プライバシー
# ============================================
# 匿名の利用実績データ送信を無効化 (デフォルト: false)
GOOSE_TELEMETRY_ENABLED=false

# Extension Manager の有効/無効 (デフォルト: false)
# GOOSE_LOCKDOWN_MODE=false

# 異常通信検知時のWebhook通知先URL (Slack/Discord等)
# ALERT_WEBHOOK_URL=

# ============================================
# 5. コンテナシステムリソース & 権限
# ============================================
# 共有メモリサイズ (GUIアプリのクラッシュ防止用)
SHM_SIZE=1gb

# コンテナ内実行ユーザーのUID/GID (ホストの一般ユーザーに合わせる)
UID=1000
GID=1000

# ============================================
# 6. 統合コントロールパネル設定
# ============================================
# コントロールパネル保護用パスワード（空欄の場合は DISABLE_AUTH=true で認証スキップ可）
CONTROL_PANEL_PASSWORD=
# DISABLE_AUTH=false

# ============================================
# 7. OpenClaw 設定
# ============================================
# noVNC Webデスクトップ接続ポート (OpenClaw用)
OPENCLAW_NOVNC_PORT=6082

# OpenClaw UI ポート
OPENCLAW_UI_PORT=18789

# OpenClaw 使用モデル（未指定時は GOOSE_MODEL または各プロバイダのデフォルトを使用）
# 例: preview/Kimi-K2.7-Code, anthropic/claude-sonnet-4-20250514
OPENCLAW_MODEL=

# OpenClaw Gateway Token (必要に応じて設定)
OPENCLAW_GATEWAY_TOKEN=


# ============================================
# 8. メッセージング連携設定 (Telegram/Discord)
# ============================================
# Telegram Bot Token
# TELEGRAM_BOT_TOKEN=

# Discord Bot Token
# DISCORD_BOT_TOKEN=
