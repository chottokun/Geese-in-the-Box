# ============================================
# Goose Egress Sandbox - 環境変数設定
# ============================================
# このファイルをコピーして .env を作成: cp .env.example .env

# ============================================
# 1. LLM プロバイダー設定 & API キー
# ============================================
# 使用するプロバイダーのAPIキーを設定してください（不要なものは空欄で可）。

# --- OpenAI ---
OPENAI_API_KEY=

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=

# --- Google (Gemini) ---
GOOGLE_API_KEY=

# --- Azure OpenAI ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-02-01

# --- AWS Bedrock ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# --- Mistral AI ---
MISTRAL_API_KEY=

# --- Groq ---
GROQ_API_KEY=

# --- OpenRouter ---
OPENROUTER_API_KEY=

# --- Together AI ---
TOGETHER_API_KEY=

# --- Cohere ---
COHERE_API_KEY=

# --- Ollama（ホスト側のローカルLLM利用時） ---
# OLLAMA_HOST=http://host.docker.internal:11434

# --- Goose デフォルトモデル設定 ---
# GOOSE_PROVIDER=openai
# GOOSE_MODEL=gpt-4o

# ============================================
# 2. ポート設定（ホスト公開ポート）
# ============================================
# noVNC Webデスクトップ接続ポート (ブラウザで開くポート)
NOVNC_PORT=6080

# Goose ACP サーバーポート (公式Goose Desktopからの接続用)
GOOSE_SERVE_PORT=3284

# Squid プロキシポート (外部通信の監査・中継用)
SQUID_PORT=3128

# ============================================
# 3. 画面 & ロケール設定
# ============================================
# 仮想デスクトップ解像度 (幅x高さx色深度)
RESOLUTION=1280x800x24

# タイムゾーン (デスクトップ時計・監査ログ時刻)
TZ=Asia/Tokyo

# ============================================
# 4. セキュリティ & プライバシー
# ============================================
# 匿名の利用実績データ送信を無効化 (デフォルト: false)
GOOSE_TELEMETRY_ENABLED=false

# ============================================
# 5. コンテナシステムリソース & 権限
# ============================================
# 共有メモリサイズ (GUIアプリのクラッシュ防止用)
SHM_SIZE=1gb

# コンテナ内実行ユーザーのUID/GID (ホストの一般ユーザーに合わせる)
UID=1000
GID=1000
