# ==========================================================
# Geese-in-the-Box: 統合ポートマップ設定 (Port Mappings)
# ==========================================================
# 本ファイルはシステム全体のポート割り当て（内部/外部）を一元管理します。
# ユーザー固有のポート変更は .env に同名変数を記述して上書き可能です。
# ==========================================================

# ----------------------------------------------------------
# 1. バインド先ホスト IP
# ----------------------------------------------------------
HOST_BIND=127.0.0.1

# ----------------------------------------------------------
# 2. 仮想デスクトップ (noVNC / Xfce4) 接続ポート (6080番台)
# ----------------------------------------------------------
# Goose Agent GUI (http://localhost:6080/vnc.html)
NOVNC_PORT=6080

# OpenCode Agent GUI (http://localhost:6081/vnc.html)
OPENCODE_NOVNC_PORT=6081

# OpenClaw Agent GUI (http://localhost:6082/vnc.html)
OPENCLAW_NOVNC_PORT=6082

# DeepSeek Harness (dsh) GUI (http://localhost:6083/vnc.html)
DSH_NOVNC_PORT=6083

# Hermes Agent GUI (http://localhost:6084/vnc.html)
HERMES_NOVNC_PORT=6084

# ----------------------------------------------------------
# 3. エージェント固有 Web UI / Gateway / プロトコルポート
# ----------------------------------------------------------
# OpenClaw Control UI / Gateway
OPENCLAW_GATEWAY_PORT=18789

# Goose ACP サーバー (公式 Goose Desktop 接続用)
GOOSE_SERVE_PORT=3284

# ----------------------------------------------------------
# 4. 監査・プロキシ・監視サービスポート
# ----------------------------------------------------------
# Squid フォワードプロキシ (外部通信監査・遮断)
SQUID_PORT=3128

# Dozzle Web リアルタイムログ監視
DOZZLE_PORT=8080
