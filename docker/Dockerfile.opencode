FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8 LC_ALL=C.UTF-8

# 0. uv / uvx のマルチステージコピー（高速・安全・決定論的）
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

# 1. 基本ツール + GUI/noVNC + 日本語入力 + 開発ランタイム
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    wget \
    ca-certificates \
    git \
    bzip2 \
    unzip \
    zip \
    patch \
    procps \
    htop \
    jq \
    ripgrep \
    tree \
    nano \
    less \
    zenity \
    # ビルドツール
    build-essential \
    python3 \
    python3-pip \
    python3-venv \
    nodejs \
    npm \
    # GUI デスクトップ環境 (Xfce4 + Xvfb + D-Bus)
    xvfb \
    xfce4 \
    xfce4-terminal \
    dbus-x11 \
    dbus \
    # VNC & Webブラウザ接続 (noVNC)
    x11vnc \
    novnc \
    websockify \
    # 日本語フォント
    fonts-noto-cjk \
    fonts-noto-color-emoji \
    # 日本語入力システム (Fcitx5 + Mozc)
    fcitx5 \
    fcitx5-mozc \
    fcitx5-frontend-gtk2 \
    fcitx5-frontend-gtk3 \
    fcitx5-frontend-qt5 \
    && rm -rf /var/lib/apt/lists/*

# 2. OpenCode CLI のインストール
RUN npm install -g @opencode/cli

# 3. OpenCode Desktop (.deb) のインストール + --no-sandbox ラッパーの設置
ARG OPENCODE_VERSION=1.18.31
RUN curl -fsSL "https://github.com/anomalyco/opencode/releases/download/v${OPENCODE_VERSION}/opencode-desktop-linux-amd64.deb" -o /tmp/opencode.deb \
    && apt-get update \
    && apt-get install -y --no-install-recommends /tmp/opencode.deb \
    && rm -f /tmp/opencode.deb \
    && rm -rf /var/lib/apt/lists/* \
    && if [ -f /opt/OpenCode/ai.opencode.desktop ]; then \
         mv /opt/OpenCode/ai.opencode.desktop /opt/OpenCode/ai.opencode.desktop.real \
         && printf '#!/bin/bash\nexport GTK_IM_MODULE=fcitx\nexport QT_IM_MODULE=fcitx\nexport XMODIFIERS=@im=fcitx\nexec /opt/OpenCode/ai.opencode.desktop.real --no-sandbox --enable-features=UseOzonePlatform --ozone-platform=x11 --enable-wayland-ime "$@"\n' > /opt/OpenCode/ai.opencode.desktop \
         && chmod +x /opt/OpenCode/ai.opencode.desktop \
         && ln -sf /opt/OpenCode/ai.opencode.desktop /usr/local/bin/opencode-desktop; \
       fi

# 4. 非rootユーザーの作成
ARG UID=1000
ARG GID=1000
RUN groupadd -g ${GID} sandboxuser \
    && useradd -m -u ${UID} -g sandboxuser -s /bin/bash sandboxuser \
    && mkdir -p /workspace /home/sandboxuser/.config/opencode /home/sandboxuser/Desktop /home/sandboxuser/.config/fcitx5 \
    && chown -R sandboxuser:sandboxuser /home/sandboxuser /workspace

# 5. デスクトップアイコン、Fcitx5、Git 初期プロファイル設定
RUN for dfile in /usr/share/applications/opencode-desktop.desktop /usr/share/applications/ai.opencode.desktop.desktop; do \
        if [ -f "$dfile" ]; then \
            cp "$dfile" /home/sandboxuser/Desktop/; \
        fi; \
    done \
    && if [ -f /home/sandboxuser/Desktop/opencode-desktop.desktop ]; then \
        chmod +x /home/sandboxuser/Desktop/opencode-desktop.desktop; \
    fi \
    && if [ -f /home/sandboxuser/Desktop/ai.opencode.desktop.desktop ]; then \
        chmod +x /home/sandboxuser/Desktop/ai.opencode.desktop.desktop; \
    fi \
    && printf "[Groups/0]\nName=Default\nDefault Layout=jp\nDefaultIM=mozc\n\n[Groups/0/Items/0]\nName=keyboard-jp\nLayout=\n\n[Groups/0/Items/1]\nName=mozc\nLayout=\n\n[GroupOrder]\n0=Default\n" > /home/sandboxuser/.config/fcitx5/profile \
    && su - sandboxuser -c "git config --global user.name 'OpenCode Agent' \
        && git config --global user.email 'opencode@sandbox.local' \
        && git config --global --add safe.directory /workspace \
        && git config --global init.defaultBranch main" \
    && chown -R sandboxuser:sandboxuser /home/sandboxuser/.config /home/sandboxuser/Desktop /home/sandboxuser/.gitconfig

# 6. 実行スクリプトのコピー
COPY bin/start-opencode-desktop.sh /bin/start-opencode-desktop.sh
RUN chmod +x /bin/start-opencode-desktop.sh

USER sandboxuser
WORKDIR /workspace

CMD ["/bin/bash"]
