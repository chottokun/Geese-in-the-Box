FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8 LC_ALL=C.UTF-8

# 1. 基本ツール + GUI/noVNC + 日本語入力
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    wget \
    ca-certificates \
    git \
    procps \
    htop \
    jq \
    nodejs \
    ripgrep \
    ffmpeg \
    # GUI デスクトップ環境 (Xfce4 + Xvfb + D-Bus)
    xvfb \
    xfce4 \
    xfce4-terminal \
    dbus-x11 \
    dbus \
    # VNC & Webブラウザ接続 (noVNC)
    x11vnc \
    novnc \
    websockify \
    # 日本語フォント
    fonts-noto-cjk \
    fonts-noto-color-emoji \
    # 日本語入力システム (Fcitx5 + Mozc)
    fcitx5 \
    fcitx5-mozc \
    fcitx5-frontend-gtk2 \
    fcitx5-frontend-gtk3 \
    fcitx5-frontend-qt5 \
    && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL https://astral.sh/uv/install.sh | env UV_INSTALL_DIR="/usr/local/bin" bash

# 2. 非rootユーザーの作成
ARG UID=1000
ARG GID=1000
RUN groupadd -g ${GID} sandboxuser \
    && useradd -m -u ${UID} -g sandboxuser -s /bin/bash sandboxuser \
    && mkdir -p /workspace /home/sandboxuser/.config/fcitx5 /home/sandboxuser/Desktop \
    && chown -R sandboxuser:sandboxuser /home/sandboxuser /workspace

# 3. Hermes のインストール
ARG HERMES_VERSION=v2026.9.24
RUN su - sandboxuser -c "curl -fsSL https://hermes-agent.nousresearch.com/install.sh | bash -s -- --branch ${HERMES_VERSION} --skip-setup"

# 4. デスクトップ設定
RUN printf "[Groups/0]\nName=Default\nDefault Layout=jp\nDefaultIM=mozc\n\n[Groups/0/Items/0]\nName=keyboard-jp\nLayout=\n\n[Groups/0/Items/1]\nName=mozc\nLayout=\n\n[GroupOrder]\n0=Default\n" > /home/sandboxuser/.config/fcitx5/profile \
    && chown -R sandboxuser:sandboxuser /home/sandboxuser/.config

# 5. デスクトップアイコンの作成
RUN printf '[Desktop Entry]\nVersion=1.0\nType=Application\nName=Hermes Agent\nComment=Hermes Agent CLI\nExec=xfce4-terminal -e /home/sandboxuser/.local/bin/hermes\nIcon=utilities-terminal\nTerminal=false\nCategories=Development;\n' > /home/sandboxuser/Desktop/hermes.desktop \
    && chmod +x /home/sandboxuser/Desktop/hermes.desktop \
    && chown sandboxuser:sandboxuser /home/sandboxuser/Desktop/hermes.desktop

# 6. 実行スクリプトのコピー
COPY bin/start-hermes-desktop.sh /bin/start-hermes-desktop.sh
RUN chmod +x /bin/start-hermes-desktop.sh

USER sandboxuser
WORKDIR /workspace

CMD ["/bin/bash"]
