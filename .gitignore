# 環境変数（APIキーを含むため必ず除外）
.env

# ワークスペース内の生成物（ルール・スキルテンプレートは管理対象）
workspace/*
!workspace/.gitkeep
!workspace/AGENTS.md
!workspace/.goosehints
!workspace/.gitignore
!workspace/.agents/
!workspace/.agents/**

# Goose設定（ローカル固有）
config/*
!config/.gitkeep

# 永続化データ・エクスポート
data/*
!data/.gitkeep
exports/

# Docker・ログ関連
squid_logs/
logs/

# OS固有
.DS_Store
Thumbs.db

# エディタ固有
.vscode/
.idea/
*.swp
*.swo
*~
*.bak

#
.agents/*